# Local development only. Generate each secret before starting.
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
JWT_SECRET=replace_with_random_secret_at_least_32_characters

# Seed credentials are prompted interactively, never baked into images.
# Optional ACCESS_TOKEN_SECONDS defaults to 900 (15 min).

# Origem exata do navegador; HTTPS exige cookie seguro.
PUBLIC_ORIGIN=http://localhost:8080
REFRESH_COOKIE_SECURE=false
REFRESH_TOKEN_SECONDS=604800
